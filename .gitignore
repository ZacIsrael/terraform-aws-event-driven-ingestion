# ============================================
# Terraform
# ============================================

# Local Terraform working directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files may contain secrets or environment-specific values
*.tfvars
*.tfvars.json

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform temporary files
.terraform.tmp

# Saved Terraform plan files
*.tfplan
*.tfplan.*
tfplan

# Terraform CLI configuration
.terraformrc
terraform.rc

# IMPORTANT:
# Do NOT ignore .terraform.lock.hcl.
# Commit Terraform dependency lock files for reproducible provider selections.


# ============================================
# Terragrunt
# ============================================

# Terragrunt download/cache directories
**/.terragrunt-cache/**

# Terragrunt debug-generated variable files
**/.terragrunt-debug.tfvars.json

# Terragrunt-generated cache/server artifacts
**/.terragrunt-cache/


# ============================================
# Node.js / TypeScript
# ============================================

# Installed Node.js dependencies
node_modules/

# Compiled application output
dist/
build/

# Test coverage output
coverage/

# TypeScript incremental build metadata
*.tsbuildinfo

# npm debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ============================================
# Environment Variables / Secrets
# ============================================

# Local environment files
.env
.env.*

# Allow a safe example environment file to be committed
!.env.example

# Private keys and certificates
*.pem
*.key


# ============================================
# IDE / Editor
# ============================================

# Visual Studio Code workspace settings
.vscode/

# JetBrains IDE settings
.idea/

# Vim swap files
*.swp


# ============================================
# Operating System
# ============================================

# macOS metadata
.DS_Store

# Windows metadata
Thumbs.db